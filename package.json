{
  "name": "cron-reminder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run export:web",
    "export:web": "npm run export:web --workspace @cron-reminder/app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build && npm run typecheck --workspace @cron-reminder/app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.13",
    "eslint": "^10.11.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "uuid": "^11.1.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
